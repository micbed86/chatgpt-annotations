{
  "manifest_version": 3,
  "name": "ChatGPT Annotations",
  "version": "0.4.0",
  "description": "Codex-style inline annotations for conversations on chatgpt.com.",
  "author": "micbed86",
  "homepage_url": "https://github.com/micbed86/chatgpt-annotations",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
